<style id="jeg_dynamic_css" type="text/css" data-type="jeg_custom-css"></style><style id="wp-custom-css">
/* Infinite Orange Bubble Effect Start*/

.bubbleHover{
    position:relative !important;
    overflow:hidden !important;
    isolation:isolate !important;
    z-index:999 !important;
}

.bubbleHover::before,
.bubbleHover::after{
    content:"" !important;
    position:absolute !important;
    border-radius:50% !important;
    background:rgba(255,140,0,.35) !important;
    pointer-events:none !important;
    z-index:9999 !important;
    animation:bubbleFloat 6s infinite linear !important;
}

.bubbleHover::before{
    width:120px !important;
    height:120px !important;
    left:-30px !important;
    bottom:-40px !important;
}

.bubbleHover::after{
    width:80px !important;
    height:80px !important;
    right:-20px !important;
    bottom:-20px !important;
    animation-delay:2s !important;
}

@keyframes bubbleFloat{

    0%{
        transform:translateY(0) scale(1);
        opacity:.4;
    }

    50%{
        transform:translateY(-40px) scale(1.2);
        opacity:.7;
    }

    100%{
        transform:translateY(-80px) scale(.8);
        opacity:0;
    }

}
/* Infinite Orange Bubble Effect End*/

.elementor-8 .elementor-element.elementor-element-70a5bc1 .elementskit-single-testimonial-slider {
  border-style: solid;
  border-width: 0px 0px 0px 3px;
  border-color: #FCB425;
  height: 340px !important;
}
@media (max-width: 767px) {
	.elementor-8 .elementor-element.elementor-element-70a5bc1 .elementskit-single-testimonial-slider {
  border-style: solid;
  border-width: 0px 0px 0px 3px;
  border-color: #FCB425;
  height: 390px !important;
}
}
#elementor-popup-modal-12504 .dialog-widget-content {
    background-color: #02010100;
    box-shadow: 2px 8px 23px 3px rgba(0, 0, 0, 0.2);
    display: none;
}


.glass-effect{
    background:rgba(255,255,255,0.12);
    backdrop-filter:blur(14px);
    -webkit-backdrop-filter:blur(14px);

    border:1px solid rgba(255,255,255,0.18);

    box-shadow:0 8px 32px rgba(0,0,0,0.12);

    border-radius:20px;

    padding:20px;
}

#waveHover .elementskit-infobox{
    position:relative !important;
    overflow:hidden !important;
    isolation:isolate !important;
    background:#fff !important;
    transition:.5s ease !important;
    z-index:1 !important;
}

#waveHover .elementskit-infobox::before{
    content:"" !important;
    position:absolute !important;
    left:-50% !important;
    bottom:-220% !important;
    width:220% !important;
    height:220% !important;
    background:#FDF7E8 !important;
    border-radius:40% !important;
    transition:all .8s ease !important;
    animation:waveMove 8s linear infinite !important;
    z-index:-1 !important;
}

#waveHover .elementskit-infobox:hover::before{
    bottom:-85% !important;
}

#waveHover .elementskit-infobox:hover,
#waveHover .elementskit-infobox:hover h3,
#waveHover .elementskit-infobox:hover p{
    color:black !important;
}

#waveHover .elementskit-info-box-icon img{
    transition:.5s ease !important;
}

#waveHover .elementskit-infobox:hover .elementskit-info-box-icon img{
    transform:scale(1.08) !important;
}

@keyframes waveMove{
    0%{
        transform:rotate(0deg);
    }
    100%{
        transform:rotate(360deg);
    }
}

/*  read more button*/
.give-donor__load_more.give-button-with-loader{
    display: none !important;
}




* hide section when donation popup opens */

.ncf3-wrapper {
    display: none;
	}

/* ============form ke last name ke leye ================= */

#give-last-name-wrap {
    display: none;
}



#give-first-name-wrap::before {
    content: "Full Name *";
    display: block; /* Ensures the content is on a new line */
    margin-bottom: 5px; /* Optional: add space between the text and the input field */
    font-size: 14px; /* Set font size to 14 pixels */
}

#give-first-name-wrap > * {
    visibility: hidden; /* Hides the original content */
}

#give-first-name-wrap > *:nth-child(2) {
    visibility: visible; /* Makes the form field visible */
    position: relative; /* Allows the input field to be positioned properly */
    top: -20px; /* Adjust the value to align the input field with the label text */
    width: 100%; /* Makes the input field full width */
    box-sizing: border-box; /* Ensures padding and border are included in the element's total width */
}ng: border-box;
}
.elementor-gf-header__sub-title{
	display:none !important;
}

#give-first-name-wrap
 {
    width: 100% !important;
}


.give-submit-button-wrap .give-submit:hover{
  background:black !important;
  color:#fff !important;
}

</style>
</head>

